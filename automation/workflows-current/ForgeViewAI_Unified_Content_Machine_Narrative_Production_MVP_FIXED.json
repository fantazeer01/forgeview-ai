    {
      "parameters": {
        "jsCode": "return items.map(item => { const raw = String(item.json.text ?? item.json.output ?? item.json.response ?? ''); let parsed = null; try { parsed = JSON.parse(raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '')); } catch {} const valid = !!(parsed && typeof parsed.hook === 'string' && Array.isArray(parsed.scenes) && parsed.scenes.length && typeof parsed.caption === 'string' && Array.isArray(parsed.hashtags)); return { json: { ...item.json, rawShorts: raw, shortsPackage: parsed, shortsValid: valid } }; });"
      },
