# Local secrets and credentials
content/config/*config.json
content/config/youtube_token.json
content/config/youtube_client_secret.json
content/config/telegram_config*.json

# Generated media and working files
output/
state/logs/
**/.venv/
**/work/
**/output/

# Runtime logs and API responses
output/automation/*_response.json
output/automation/*_stdout.log
output/automation/*_stderr.log

# Python caches
__pycache__/
**/__pycache__/
.pytest_cache/
**/.pytest_cache/
*.pyc
**/*.pyc

# Standardized ForgeView runtime data
state/*.json
!state/*.example.json

# Large runtime artifacts
polymarket/runs/
polymarket/data/**/input_sessions/
*.jsonl
*.parquet
*.log
**/*.jsonl
**/*.parquet
**/*.log

# Local transactional research state
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
